# Static export writes the share images without a file extension; tell browsers and crawlers they are PNGs.
/opengraph-image
  Content-Type: image/png
/twitter-image
  Content-Type: image/png

# Keep the Cloudflare preview domain out of search results so it doesn't compete with manrajchauhan.com.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Hashed build assets never change; let browsers cache them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
